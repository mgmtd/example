[
  {example, [
     {http, [
        {enabled, true},
        {port, 8080}
     ]}
  ]},
  {mgmtd, [
     {aaa, [
        {default_role, read_only},
        %% uid 0 and the user that started the VM are admin.
        %% Other local Unix users who attach to the CLI socket are read-only.
        %% Override with {users, [{Uid, Role} | {Name, Role}]}.
        {users, [{"sean", admin, "sean"}]}
     ]},
     {restconf, [
        {enabled, true},
        {port, 8008}
     ]}
  ]}
].
